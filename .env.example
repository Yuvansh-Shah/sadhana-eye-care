# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# --- Appointment form -------------------------------------------------
# Web3Forms access key for the appointment request form.
# Get a free key at https://web3forms.com — enter the clinic's email and
# the key is sent to that inbox. No account or password required.
# Without a key, the form falls back to opening the visitor's email client.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Website assistant ------------------------------------------------
# NVIDIA API key for the AI assistant. SERVER-SIDE ONLY — it has no
# NEXT_PUBLIC_ prefix, so it is never sent to the browser.
# Get a key at https://build.nvidia.com.
NVIDIA_API_KEY=

# Model used by the assistant (optional — defaults to the value below).
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
